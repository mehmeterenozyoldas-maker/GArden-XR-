    uiPanels: [], rightController: null, leftController: null, paletteGroup: null, guideGroup: null,
    ghostPipe: null, instructionSprite: null, sunLight: null, scannerLaser: null, 
    particles: null, waterBubbles: [], iotDisplays: [], rebuildRequired: true, 
    isEraserMode: false, isMoveMode: false, isScanning: false, assemblyGroup: null, grid: null, floor: null,
    lastAssemblyStep: 0, guideVisible: true, toggleGuideBtn: null, aiVisualizer: null, aiText: null,
    placementReticle: null, flowTexture: null, spatialScannerGroup: null, realPlaneGroup: null,
    
    // Spatial SDK Rigidbody & Scanning State
