  });

  // Sync State to Refs
  useEffect(() => { configRef.current = activeConfig; engineRef.current.rebuildRequired = true; }, [activeConfig]);
  useEffect(() => { plantRef.current = activePlant; engineRef.current.rebuildRequired = true; }, [activePlant]);
  useEffect(() => { widthRef.current = sysWidth; engineRef.current.rebuildRequired = true; }, [sysWidth]);
  useEffect(() => { tiersRef.current = sysTiers; engineRef.current.rebuildRequired = true; }, [sysTiers]);
