    return () => clearInterval(interval);
  }, [isTimeAnimating]);

  // --- SPATIAL SDK AUTO LAYOUT SCANNER ENGINE ---
  const triggerAutoDesign = () => {
    if (engineRef.current.isScanning) return; 
    engineRef.current.isScanning = true;
    setIsScanning(true);
    
    if (engineRef.current.aiText) engineRef.current.aiText.userData.updateText("SCANNING REAL SPATIAL MESH...", '#f59e0b');
    
    if (engineRef.current.spatialScannerGroup) {
        engineRef.current.spatialScannerGroup.visible = !engineRef.current.realWorldPlanesActive; // Only show generic scanner if real planes failed
        engineRef.current.spatialScannerGroup.scale.set(0.1, 0.1, 0.1);
    }
    
    // Simulate processing delay for dramatic effect while the real planes animate
    setTimeout(() => {
      const config = configRef.current; 
      const w = widthRef.current;
      const spacingX = w + 0.6; // Width + walk aisle
      const spacingZ = 1.2;     // Depth gap
      const optimizedPoints = [];

      let rows = 2; let cols = 2;
      let centerX = 0; let centerZ = -2.0;

      // 🌐 REAL-WORLD SPATIAL MATH INJECTION 🌐
      if (engineRef.current.realFloorBounds && engineRef.current.renderer.xr.isPresenting) {
          const bounds = engineRef.current.realFloorBounds;
          centerX = bounds.center.x;
          centerZ = bounds.center.z;
          
          // Calculate max physical units that can fit inside the real room dimensions
          cols = Math.max(1, Math.floor((bounds.width * 0.9) / spacingX)); // Use 90% of floor space
          rows = Math.max(1, Math.floor((bounds.depth * 0.9) / spacingZ));
          
          if (engineRef.current.aiText) {
              engineRef.current.aiText.userData.updateText(`PHYSICAL ROOM MATCH: ${cols * rows} SYSTEMS`, '#10b981');
          }
      } else {
          // Fallback if not in AR or planes not detected
          if (config === 'TOWERS') { rows = 2; cols = 3; }
          else if (config === 'HORIZ-BED' || config === 'ZIG-ZAG') { rows = 2; cols = 2; }
      }

      if (config === 'BIOMESH') {
          optimizedPoints.push(new THREE.Vector3(-1.5 + centerX, 0.5, -1 + centerZ)); 
          optimizedPoints.push(new THREE.Vector3(1.5 + centerX, 0.4, -1 + centerZ)); 
          optimizedPoints.push(new THREE.Vector3(1.5 + centerX, 0.3, 0 + centerZ));
          optimizedPoints.push(new THREE.Vector3(-1.5 + centerX, 0.2, 0 + centerZ)); 
          optimizedPoints.push(new THREE.Vector3(-1.5 + centerX, 0.1, 1 + centerZ)); 
          optimizedPoints.push(new THREE.Vector3(1.5 + centerX, 0.0, 1 + centerZ));
      } else {
          for(let r=0; r<rows; r++) {
            for(let c=0; c<cols; c++) {
               const offsetX = centerX + (c - (cols-1)/2) * spacingX;
               const offsetZ = centerZ + (r - (rows-1)/2) * spacingZ; 
               optimizedPoints.push(new THREE.Vector3(offsetX, 0, offsetZ));
            }
          }
      }
      
      engineRef.current.points = optimizedPoints; 
      engineRef.current.rebuildRequired = true; 
      
      engineRef.current.isScanning = false;
      setIsScanning(false);
      
      if (engineRef.current.spatialScannerGroup) engineRef.current.spatialScannerGroup.visible = false;
      
      if (!engineRef.current.realFloorBounds || !engineRef.current.renderer.xr.isPresenting) {
         if (engineRef.current.aiText) engineRef.current.aiText.userData.updateText(`FALLBACK LAYOUT: ${optimizedPoints.length} SYSTEMS`, '#10b981');
      }
      
      setTimeout(() => {
          if (engineRef.current.aiText) engineRef.current.aiText.userData.updateText("GEMINI COPILOT ACTIVE", '#38bdf8');
      }, 4000);

    }, 3500); 
  };

  // Main Engine Initialization
  useEffect(() => {
    if (!mountRef.current) return;

    // --- SCENE SETUP ---
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#000000'); 
    scene.fog = new THREE.FogExp2('#000000', 0.03); 
    engineRef.current.scene = scene;
    
    // Fallback Grid & Floor
    const grid = new THREE.GridHelper(30, 30, 0x1f2937, 0x111827);
    grid.material.transparent = true; grid.material.opacity = 0.5;
    scene.add(grid);
    engineRef.current.grid = grid;

    const shadowPlane = new THREE.Mesh(new THREE.PlaneGeometry(30, 30), new THREE.ShadowMaterial({ opacity: 0.3, color: 0x000000 }));
    shadowPlane.rotation.x = -Math.PI / 2; shadowPlane.position.y = -0.01; shadowPlane.receiveShadow = true;
    scene.add(shadowPlane);
    engineRef.current.floor = shadowPlane; 
    
    // Group for True Spatial WebXR Planes
    const realPlaneGroup = new THREE.Group();
    scene.add(realPlaneGroup);
    engineRef.current.realPlaneGroup = realPlaneGroup;

    // Camera & Renderer
    const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 1.4, 2.5);
    engineRef.current.camera = camera;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.xr.enabled = true;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0; 
    mountRef.current.appendChild(renderer.domElement);
    engineRef.current.renderer = renderer;

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true; controls.dampingFactor = 0.05; controls.maxPolarAngle = Math.PI / 2 - 0.05; 
    controls.target.set(0, 1.1, 0);

    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    pmremGenerator.compileEquirectangularShader();
    scene.environment = pmremGenerator.fromScene(new RoomEnvironment()).texture;

    const assemblyGroup = new THREE.Group();
    engineRef.current.assemblyGroup = assemblyGroup;
    scene.add(assemblyGroup);

    // Particles
    const particleGeo = new THREE.BufferGeometry();
    const pPos = new Float32Array(510); 
    for(let i=0; i<510; i++) pPos[i] = (Math.random() - 0.5) * 15;
    particleGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
    const particles = new THREE.Points(particleGeo, new THREE.PointsMaterial({ size: 0.03, color: 0x0064FF, transparent: true, opacity: 0.3, depthWrite: false }));
    scene.add(particles); engineRef.current.particles = particles;

    // Simulated Scanner Fallback Group
    const scannerGroup = new THREE.Group();
    scannerGroup.visible = false;
    scene.add(scannerGroup);
    engineRef.current.spatialScannerGroup = scannerGroup;

    const scanGrid = new THREE.GridHelper(10, 25, 0x0064FF, 0x0ea5e9);
    scanGrid.position.y = 0.01; scanGrid.material.transparent = true; scanGrid.material.opacity = 0.8;
    scannerGroup.add(scanGrid);

    const boundingMat = new THREE.MeshBasicMaterial({ color: 0x0ea5e9, wireframe: true, transparent: true, opacity: 0.6 });
    const boundingFillMat = new THREE.MeshBasicMaterial({ color: 0x0ea5e9, transparent: true, opacity: 0.1 });
    
    const wallMesh = new THREE.Mesh(new THREE.BoxGeometry(6, 3, 0.2), boundingMat);
    wallMesh.position.set(0, 1.5, -4); wallMesh.add(new THREE.Mesh(new THREE.BoxGeometry(6, 3, 0.2), boundingFillMat));
    
    const tableMesh = new THREE.Mesh(new THREE.BoxGeometry(2, 0.8, 1), boundingMat);
    tableMesh.position.set(-2.5, 0.4, -2); tableMesh.add(new THREE.Mesh(new THREE.BoxGeometry(2, 0.8, 1), boundingFillMat));
    scannerGroup.add(wallMesh, tableMesh);

    // Spatial Targeting Reticle
    const reticleGeo = new THREE.RingGeometry(0.28, 0.32, 32).rotateX(-Math.PI / 2);
    const reticleMat = new THREE.MeshBasicMaterial({ color: 0x0ea5e9, transparent: true, opacity: 0.8, side: THREE.DoubleSide });
    const reticle = new THREE.Mesh(reticleGeo, reticleMat);
    reticle.visible = false;
    scene.add(reticle);
    engineRef.current.placementReticle = reticle;

    // Flowing Water Texture Generator
    const createFlowTexture = () => {
        const canvas = document.createElement('canvas');
        canvas.width = 16; canvas.height = 128;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#0f172a'; ctx.fillRect(0,0,16,128); 
        ctx.fillStyle = '#38bdf8'; ctx.fillRect(0,0,16,64); // Water pulse stripe
        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping; tex.repeat.set(1, 8);
        return tex;
    };
    engineRef.current.flowTexture = createFlowTexture();

    // Lights
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const softFill = new THREE.PointLight(0x0064FF, 1, 15); softFill.position.set(0, 4, 0); scene.add(softFill);

    const sunLight = new THREE.DirectionalLight(0xfff5e6, 2.0);
    sunLight.castShadow = true; sunLight.shadow.bias = -0.001; 
    sunLight.shadow.mapSize.width = 2048; sunLight.shadow.mapSize.height = 2048;
    scene.add(sunLight); engineRef.current.sunLight = sunLight;

    // --- META HORIZON OS UI ENGINE ---
    const colorPrimary = 0x0064FF; 
    const colorSurface = 0x292D39; 
    const colorSurfaceHover = 0x3B404D;
    const colorCard = 0x1A1D24; 
    const colorPanel = 0x0A0A0A; 

    const createRoundedRectShape = (width, height, radius) => {
        const shape = new THREE.Shape();
        const x = -width / 2, y = -height / 2;
        shape.moveTo(x, y + radius);
        shape.lineTo(x, y + height - radius);
        shape.quadraticCurveTo(x, y + height, x + radius, y + height);
        shape.lineTo(x + width - radius, y + height);
        shape.quadraticCurveTo(x + width, y + height, x + width, y + height - radius);
        shape.lineTo(x + width, y + radius);
        shape.quadraticCurveTo(x + width, y, x + width - radius, y);
        shape.lineTo(x + radius, y);
        shape.quadraticCurveTo(x, y, x, y + radius);
        return shape;
    };

    const createCrispTextSprite = (initialText, options = {}) => {
        const {
            fontsize = 64, fontface = '"Inter", sans-serif', textColor = '#F5F5F5',
            canvasWidth = 1024, canvasHeight = 128, fontWeight = '700', 
            physicalHeight = 0.04, align = 'center'
        } = options;

        const canvas = document.createElement('canvas');
        canvas.width = canvasWidth; canvas.height = canvasHeight;
        const ctx = canvas.getContext('2d');
        const texture = new THREE.CanvasTexture(canvas);
        texture.minFilter = THREE.LinearFilter; texture.magFilter = THREE.LinearFilter; texture.anisotropy = 16;
        
        const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false }));
        sprite.raycast = () => {}; 

        sprite.userData.updateText = (text, activeColor = textColor) => {
            ctx.clearRect(0, 0, canvasWidth, canvasHeight);
            ctx.font = `${fontWeight} ${fontsize}px ${fontface}`;
            ctx.fillStyle = activeColor;
            ctx.textBaseline = 'middle';
            ctx.shadowColor = "rgba(0, 0, 0, 0.6)"; 
            ctx.shadowBlur = 8; ctx.shadowOffsetY = 2;
            
            if(align === 'left') {
                ctx.textAlign = 'left';
                ctx.fillText(text, 20, canvasHeight / 2);
            } else {
                ctx.textAlign = 'center';
                ctx.fillText(text, canvasWidth / 2, canvasHeight / 2);
            }
            texture.needsUpdate = true;
        };
        
        sprite.userData.updateText(initialText);
        sprite.scale.set(physicalHeight * (canvasWidth / canvasHeight), physicalHeight, 1);
        return sprite;
    };

    const createXRCardBg = (width, height, x, y) => {
        const shape = createRoundedRectShape(width, height, 0.03); 
        const geo = new THREE.ExtrudeGeometry(shape, { depth: 0.005, bevelEnabled: false });
        geo.translate(0, 0, -0.0025);
        const mat = new THREE.MeshPhysicalMaterial({ color: colorCard, roughness: 0.5, metalness: 0.1, transparent: true, opacity: 0.95 });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(x, y, 0.005);
        mesh.raycast = () => {};
        return mesh;
    };

    const createXRButton = (text, width, height, x, y, actionData, isPrimary = false, danger = false) => {
        const radius = height / 2; 
        const btnShape = createRoundedRectShape(width, height, radius);
        const btnGeo = new THREE.ExtrudeGeometry(btnShape, { depth: 0.01, bevelEnabled: false });
        btnGeo.translate(0, 0, -0.005); 

        const dColor = isPrimary ? colorPrimary : (danger ? 0xE11D48 : colorSurface);
        const aColor = isPrimary ? 0x0050CC : (danger ? 0xBE123C : colorPrimary);

        const btnMat = new THREE.MeshPhysicalMaterial({ 
            color: dColor, roughness: 0.3, metalness: 0.1, emissive: dColor, emissiveIntensity: 0.1 
        });
        
        const btn = new THREE.Mesh(btnGeo, btnMat);
        btn.position.set(x, y, 0.015); 
        btn.userData = { 
            isButton: true, isHovered: false, isClicked: false, baseZ: 0.015,
            ...actionData, defaultColor: dColor, hoverColor: isPrimary ? 0x3385FF : colorSurfaceHover, activeColor: aColor 
        };
        
        const label = createCrispTextSprite(text, { physicalHeight: height * 0.40, fontWeight: '700' });
        label.position.set(0, 0, 0.006); 
        btn.add(label);
        btn.userData.labelSprite = label; 
        
        return btn;
