  useEffect(() => { engineRef.current.isMoveMode = isMoveMode; }, [isMoveMode]);
  useEffect(() => { timeRef.current = timeOfDay; }, [timeOfDay]);
  useEffect(() => { engineRef.current.assemblyStep = assemblyStep; engineRef.current.rebuildRequired = true; }, [assemblyStep]);
  useEffect(() => { engineRef.current.isAnimating = isAnimating; }, [isAnimating]);
  useEffect(() => { engineRef.current.isTimeAnimating = isTimeAnimating; }, [isTimeAnimating]);

  // Timers
  useEffect(() => {
    let interval;
    if (isAnimating) interval = setInterval(() => setGrowthMonth(prev => prev >= 12 ? (setIsAnimating(false), 12) : prev + 0.15), 50); 
    return () => clearInterval(interval);
