    const createBlueprintSprite = (initialStepData, physicalWidth = 0.75, physicalHeight = 0.60) => {
      const canvasWidth = 2048; const canvasHeight = 1536;
      const canvas = document.createElement('canvas'); 
      canvas.width = canvasWidth; canvas.height = canvasHeight; 
      const ctx = canvas.getContext('2d');
      const texture = new THREE.CanvasTexture(canvas); 
      texture.minFilter = THREE.LinearFilter; texture.magFilter = THREE.LinearFilter; texture.anisotropy = 16;
      const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false }));
      sprite.raycast = () => {}; 

      sprite.userData.updateText = (stepData) => {
        ctx.clearRect(0, 0, canvasWidth, canvasHeight); 
        const fontStack = `"Inter", sans-serif`;
        
        ctx.fillStyle = '#1A1D24'; 
        ctx.roundRect(0, 0, canvasWidth, canvasHeight, 32); 
        ctx.fill();
        ctx.strokeStyle = '#333333'; ctx.lineWidth = 4; ctx.strokeRect(0, 0, canvasWidth, canvasHeight); 
        
        ctx.fillStyle = '#292D39'; 
        ctx.beginPath(); ctx.roundRect(0, 0, canvasWidth, 260, [32, 32, 0, 0]); ctx.fill();

        ctx.textAlign = 'left'; ctx.textBaseline = 'top'; 
        ctx.fillStyle = '#0064FF'; ctx.font = `800 48px ${fontStack}`; 
        ctx.fillText(`ASSEMBLY PHASE ${stepData.step}`, 80, 60);

        ctx.fillStyle = '#FFFFFF'; ctx.font = `900 80px ${fontStack}`; 
        ctx.fillText(stepData.title.toUpperCase(), 80, 130);

        ctx.fillStyle = '#A8B1BD'; ctx.font = `700 40px ${fontStack}`; 
        ctx.fillText("REQUIRED HARDWARE:", 80, 320);
        ctx.fillStyle = '#F5F5F5'; ctx.font = `600 40px ${fontStack}`; 
        ctx.fillText(stepData.tools, 540, 320);
        
        ctx.strokeStyle = '#333333'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(80, 400); ctx.lineTo(canvasWidth - 80, 400); ctx.stroke();

        ctx.fillStyle = '#E0E0E0'; ctx.font = `500 56px ${fontStack}`; 
        stepData.lines.forEach((line, i) => { ctx.fillText(line, 80, 460 + (i * 140)); });
        texture.needsUpdate = true;
      };
      
      sprite.userData.updateText(initialStepData); 
      sprite.scale.set(physicalWidth, physicalHeight, 1); 
      return sprite;
    };

